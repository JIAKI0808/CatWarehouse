{
  "name": "cw-client",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "build:strict": "vue-tsc --build --force && vite build",
    "start": "electron .",
    "type-check": "vue-tsc --build --force",
    "mirror:check": "node scripts/mirror.mjs --check",
    "mirror:apply": "node scripts/mirror.mjs --apply",
    "mirror:prune": "node scripts/mirror.mjs --apply --prune",
    "pack:dir": "electron-builder --dir",
    "pack:win": "electron-builder --win"
  },
  "dependencies": {
    "@vicons/ionicons5": "^0.13.0",
    "echarts": "^6.1.0",
    "gsap": "^3.15.0",
    "naive-ui": "^2.44.1",
    "pinia": "^3.0.3",
    "vue": "^3.5.13",
    "vue-echarts": "^8.0.1",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.1",
    "@tsconfig/node22": "^22.0.0",
    "@types/node": "^22.15.2",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/tsconfig": "^0.8.0",
    "electron": "28.3.3",
    "tailwindcss": "^4.3.1",
    "typescript": "~5.8.0",
    "vite": "^6.3.2",
    "vue-tsc": "^2.2.8"
  }
}
